<Window x:Class="PedaFlotta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" Loaded="OnLoaded" FontSize="20" FontWeight="Bold">
    <Grid >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="4.5*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>
            <Canvas x:Name="CanvasVitesse" Grid.Row="1" Grid.Column="0"  Margin="10">
                <Canvas.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                        <GradientStop Color="Red" Offset="0.21" />
                        <!--  17m/min -->
                        <GradientStop Color="Orange" Offset="0.22" />
                        <!--  15m/min -->
                        <GradientStop Color="Orange" Offset="0.33" />
                        <!--  10m/min -->
                        <GradientStop Color="Yellow" Offset="0.34" />
                        <!--  9m/min -->
                        <GradientStop Color="Yellow" Offset="0.44" />
                        <!--  9m/min -->
                        <GradientStop Color="Green" Offset="0.45" />
                        <!--  6m/min -->
                        <GradientStop Color="Green" Offset="0.50" />
                        <GradientStop Color="Blue" Offset="0.50" />
                    </LinearGradientBrush>
                </Canvas.Background>
                <Rectangle x:Name="VitesseBarre" Fill="Black" Grid.Row="1" Grid.Column="0" />
            </Canvas>
            <Canvas x:Name="CanvasPoumon"  Background="#222222"   Grid.Row="1" Grid.Column="3"  Margin="10">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="-1" CenterX=".5" CenterY=".5" />
                </Canvas.LayoutTransform>
            </Canvas>
            <Canvas x:Name="CanvasPoumonGrid"   Grid.Row="1" Grid.Column="3"  Margin="10" Background="Transparent"/>
            <Canvas x:Name="CanvasGilet"  Background="#1111"   Grid.Row="2" Grid.Column="3"  Margin="10">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="-1" CenterX=".5" CenterY=".5" />
                </Canvas.LayoutTransform>
            </Canvas>
            <Canvas x:Name="CanvasGiletGrid" Grid.Row="2" Grid.Column="3"  Margin="10" Background="Transparent"/>
            <Canvas x:Name="CanvasTraj"   Grid.Row="1" Grid.Column="2"  Margin="10" Background="Gray"/>

            <Slider x:Name="OffsetPoumonSlider"  Grid.Row="1" Grid.Column="4"  Minimum="1.5" Maximum="4.5" LargeChange="0" SmallChange="0" MouseDoubleClick="DoubleSlider" Orientation="Vertical" Value="{Binding Path=OffsetRespiration, UpdateSourceTrigger=PropertyChanged}"  Grid.RowSpan="4"/>
            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Button x:Name="BtnMontée"      Grid.Row="2" Grid.Column="0"  PreviewMouseUp="BtnMontée_MouseUp"      PreviewMouseDown="BtnMontée_MouseDown"/>
                <Button x:Name="BtnDescente"    Grid.Row="2" Grid.Column="2"  PreviewMouseUp="BtnDescente_MouseUp"    PreviewMouseDown="BtnDescente_MouseDown"/>
                <Button x:Name="BtnBloqué"      Grid.Row="2" Grid.Column="4"  PreviewMouseUp="BtnBloqué_MouseUp"      PreviewMouseDown="BtnBloqué_MouseDown"/>
                <Button x:Name="BtnExpiré"      Grid.Row="2" Grid.Column="6"  PreviewMouseUp="BtnExpiré_MouseUp"      PreviewMouseDown="BtnExpiré_MouseDown"/>
                <Button x:Name="BtnPurge"       Grid.Row="2" Grid.Column="8"  PreviewMouseUp="BtnPurge_MouseUp"       PreviewMouseDown="BtnPurge_MouseDown"/>
                <Button x:Name="BtnPurgeRapide" Grid.Row="2" Grid.Column="10" PreviewMouseUp="BtnPurgeRapide_MouseUp" PreviewMouseDown="BtnPurgeRapide_MouseDown"/>
                <Button x:Name="BtnGilet"       Grid.Row="2" Grid.Column="12" PreviewMouseUp="BtnGilet_MouseUp"       PreviewMouseDown="BtnGilet_MouseDown"/>
                <Button x:Name="BtnSport"       Grid.Row="2" Grid.Column="14" PreviewMouseUp="BtnSport_MouseUp"       PreviewMouseDown="BtnSport_MouseDown"/>
                <Label Content="Montée" Grid.Row="1" Grid.Column="0"/>
                <Label Content="Descente" Grid.Row="1" Grid.Column="2"/>
                <Label Content="Bloqué" Grid.Row="1" Grid.Column="4"/>
                <Label Content="Expiré" Grid.Row="1" Grid.Column="6"/>
                <Label Content="Purge" Grid.Row="1" Grid.Column="8"/>
                <Label Content="Purge Rapide" Grid.Row="1" Grid.Column="10"/>
                <Label Content="Gilet" Grid.Row="1" Grid.Column="12"/>
                <Label Content="Sport" Grid.Row="1" Grid.Column="14"/>
            </Grid>
            <Grid x:Name="GridPlongeur" Grid.Column="1" Grid.Row="1" Background="Blue"  Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="BulleCanvas" Grid.ColumnSpan="18" Grid.RowSpan="15"/>
                <Label x:Name="FpsLabel" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="4" Foreground="White"/>
                <Label x:Name="ce" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="4" Foreground="White"/>
            </Grid>
            <Grid x:Name="GridInfo" Grid.Column="2" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" x:Name="ProfondeurLabel" Content="Prof" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <Label Grid.Row="1" x:Name="PoidsApparentLabel" Content="Sec" HorizontalAlignment="Center"   VerticalAlignment="Center" />
                <Label Grid.Row="2" x:Name="VitesseLabel" Content="Vitesse" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Label Grid.Row="3"  x:Name="TimeLabel"  Content="Sec" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <Label Grid.Row="4"  x:Name="GiletAbsLabel"  Content="Sec" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <Label Grid.Row="5"  x:Name="GiletRelLabel"  Content="Sec" HorizontalAlignment="Center"  VerticalAlignment="Center" />
            </Grid>
            <Canvas x:Name="PlongeurCanvas"   Grid.Row="1" Grid.Column="1"  >
                <Image x:Name="Plongeur" Width="250" Height="200" Source="C:\Users\Adam\Documents\CopieNasAdam\StageMovx\PedaFlottaV1.12\img\plongeur.png"/>

            </Canvas>
            <Label x:Name="ScoreLabel" Content="Score" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            
        </Grid>
    </Grid>
</Window>